# JavaScript / Vite output
/node_modules/
/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Rust / Tauri build output
/src-tauri/target/
*.rs.bk

# Python local caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

